{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.4.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:49832/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://soundcloud.com/*",
    "https://www.soundcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://soundcloud.com/*",
        "https://www.soundcloud.com/*"
      ],
      "js": [
        "soundcloud-reader.js",
        "soundcloud.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Presence Studio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "incognito": "not_allowed",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
