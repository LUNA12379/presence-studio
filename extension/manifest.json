{
  "manifest_version": 3,
  "name": "Presence Studio — YouTube & SoundCloud",
  "version": "1.3.0",
  "description": "Show YouTube, YouTube Music and SoundCloud playback in Discord through the local Presence Studio app.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["http://127.0.0.1:49832/*", "https://www.youtube.com/*", "https://music.youtube.com/*", "https://soundcloud.com/*", "https://www.soundcloud.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://soundcloud.com/*", "https://www.soundcloud.com/*"], "js": ["soundcloud-reader.js", "soundcloud.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "Presence Studio" },
  "incognito": "not_allowed"
}
